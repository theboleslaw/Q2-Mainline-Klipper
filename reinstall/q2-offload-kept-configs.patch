From 5798471b8af7a712b4f46e3017b01a5bc77eb468 Mon Sep 17 00:00:00 2001
From: Cedric Hauber <hauber.c@gmail.com>
Date: Wed, 25 Nov 2026 11:36:45 +0100
Subject: [PATCH] fix: show the config files an update kept, and take their new
 version in one command

An edited (or hand-copied) config file was kept with its new version
written as .new, and the only trace was a warning in the update log: a
host could run three-week-old macros without anyone noticing.

- the update records the files it kept (not printer.cfg, which is never
  replaced) and lists them with what to do: in the end-of-update dialog
  in Mainsail/Fluidd (alone or with the "Klipper kept" one), and at the
  end of install.sh install/update/host in the terminal
- install.sh use-new replaces each kept file by its .new, keeps the
  user's as .bak-<date>, and restarts Klipper; refused during a print
- .new files (and config files created on a fresh install) were 0600,
  the mode of the mktemp file they were copied from: now 0644
- tests/host/kept-configs.sh (host matrix): edit a file, check the
  notice, the list, the mode, use-new and that the notice goes away
---
 docs/use/updates.md        |  8 ++++--
 install.sh                 | 22 ++++++++++++----
 scripts/host.sh            | 52 ++++++++++++++++++++++++++++++++++++++
 tests/host/kept-configs.sh | 27 ++++++++++++++++++++
 tests/host/run.sh          |  2 ++
 5 files changed, 104 insertions(+), 7 deletions(-)
 create mode 100755 tests/host/kept-configs.sh

diff --git a/docs/use/updates.md b/docs/use/updates.md
index ddbdb7d..2db6859 100644
--- a/docs/use/updates.md
+++ b/docs/use/updates.md
@@ -47,8 +47,12 @@ is offered.
 
 ## What is yours
 
-- Your edits to the installed config files are kept. When q2-offload changes one of them, the
-  new version is written next to yours as `*.new`: compare them when you have a moment.
+- Your edits to the installed config files are kept, and so are files copied there by hand.
+  When q2-offload changes one of them, the new version is written next to yours as `*.new`,
+  and the end of the update lists them: in the dialog in Mainsail or Fluidd, and in the
+  terminal. Compare each with its `.new`; to take the new versions, when no print is running,
+  run `cd ~/q2-offload && ./install.sh use-new` on the host. It keeps yours as `.bak-<date>`
+  and restarts Klipper. `printer.cfg` is never replaced: its `.new` is only for comparison.
 - `printer.cfg` and `moonraker.conf` are yours after the first install: updates don't change
   them. When a version brings something worth adding there, the
   [older installs](../reference/older-installs.md) page says what.
diff --git a/install.sh b/install.sh
index 794a7f0..b4bbd25 100755
--- a/install.sh
+++ b/install.sh
@@ -9,6 +9,7 @@
 #   ./install.sh printer         (re)configure only the printer board (proxies, HelixScreen)
 #   ./install.sh flash           reflash the MCUs, then bring Klipper to the same version
 #   ./install.sh status          show what is installed and running
+#   ./install.sh use-new         take the new version of the config files an update kept (*.new)
 #   ./install.sh check           check that every installed service answers
 #   ./install.sh calibrate       check the load cell (three taps), then offer PID and input shaper
 #
@@ -55,11 +56,11 @@ fi
 ALL_COMPONENTS=mainsail,fluidd,spoolman,autopa,detect
 SETTINGS="${STATE_DIR}/settings.env"
 
-usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
+usage() { sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
 
 command="install"
 case "${1:-}" in
-    install|update|host|printer|flash|status|check|calibrate|_update-check|_update-user) command="$1"; shift ;;
+    install|update|host|printer|flash|status|check|calibrate|use-new|_update-check|_update-user) command="$1"; shift ;;
     -h|--help) usage ;;
 esac
 while [ $# -gt 0 ]; do
@@ -277,6 +278,7 @@ EOF
     fi
     local healthy=0
     verify_install || healthy=1
+    kept_configs_report
     final_notes "$healthy"
 }
 
@@ -306,7 +308,10 @@ EOF
     wait_ready || true
     printer_helixscreen_update
     [ "$KEEP_KLIPPER" = 1 ] && warn "Klipper kept at $(klipper_version): run ./install.sh flash to move to $(firmware_id)"
-    verify_install
+    local healthy=0
+    verify_install || healthy=1
