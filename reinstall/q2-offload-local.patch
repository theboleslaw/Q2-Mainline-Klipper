diff --git a/patches/happy-hare/0012-feat-heater-rotate-empty-spools-in-print.patch b/patches/happy-hare/0012-feat-heater-rotate-empty-spools-in-print.patch
new file mode 100644
index 0000000..3ce5ef0
--- /dev/null
+++ b/patches/happy-hare/0012-feat-heater-rotate-empty-spools-in-print.patch
@@ -0,0 +1,193 @@
+From 590b749906d05b9a7066a4f25c33fef5d13e4fb5 Mon Sep 17 00:00:00 2001
+From: q2-offload <q2-offload@users.noreply.github.com>
+Date: Thu, 12 Nov 2026 01:34:37 +0800
+Subject: [PATCH] feat(heater): rotate empty spools during print heating
+
+---
+ extras/mmu/commands/mmu_heater.py          | 12 +++
+ extras/mmu/unit/mmu_environment_manager.py | 85 ++++++++++++++++------
+ 2 files changed, 74 insertions(+), 23 deletions(-)
+
+diff --git a/extras/mmu/commands/mmu_heater.py b/extras/mmu/commands/mmu_heater.py
+index 38a83e04..10f306f2 100644
+--- a/extras/mmu/commands/mmu_heater.py
++++ b/extras/mmu/commands/mmu_heater.py
+@@ -170,6 +170,9 @@ class MmuHeaterCommand(BaseCommand):
+                     em.set_heater_target(temp, gates)
+                 except MmuError as e:
+                     self.mmu.log_error(str(e))
++                if rotate:
++                    em.start_rotation(gates, rotate_interval)
++                    self.mmu.log_info("Spool rotation enabled while print heating")
+                 return
+ 
+             # Single heater mode
+@@ -177,6 +180,15 @@ class MmuHeaterCommand(BaseCommand):
+                 em.set_heater_target(temp)
+             except MmuError as e:
+                 self.mmu.log_error(str(e))
++            if rotate:
++                em.start_rotation(None, rotate_interval)
++                self.mmu.log_info("Spool rotation enabled while print heating")
++            return
++
++        # Rotation only (on an already-running print heater or drying cycle)
++        if not dry and temp is None and rotate:
++            em.start_rotation(gates if gates_param else None, rotate_interval)
++            self.mmu.log_info("Spool rotation enabled")
+             return
+ 
+         # Initiate drying cycle -------------------------------------------------
+diff --git a/extras/mmu/unit/mmu_environment_manager.py b/extras/mmu/unit/mmu_environment_manager.py
+index f9544a1a..d23b3cbf 100644
+--- a/extras/mmu/unit/mmu_environment_manager.py
++++ b/extras/mmu/unit/mmu_environment_manager.py
+@@ -85,6 +85,7 @@ class MmuEnvironmentManager:
+         self.printer.register_event_handler("mmu:espooler_burst_done", self._handle_espooler_burst_done)
+ 
+         self._periodic_timer = self.reactor.register_timer(self._check_mmu_environment)
++        self._rotation_timer = self.reactor.register_timer(self._check_rotation)
+ 
+         # Gear rotation while printing lives outside reinit() so a running move is always finished off
+         self._bg_rotate_timer = self.reactor.register_timer(self._bg_rotate_event)
+@@ -135,6 +136,7 @@ class MmuEnvironmentManager:
+         self._rotate_timer = None
+         self._rotate_enabled = False
+         self._rotate_print_warned = False
++        self._rotation_gates = None
+         self.spools_to_rotate = [] # Queue of spools that we are rotating (one at a time)
+ 
+ 
+@@ -249,6 +251,7 @@ class MmuEnvironmentManager:
+         self.spools_to_rotate = []
+         self._rotate_enabled = bool(rotate)
+         self._rotate_print_warned = False
++        self._rotation_gates = None
+         self._rotate_timer = self._drying_rotate_interval * 60.0 if self._rotate_enabled else None
+ 
+         return per_gate_plan, warnings, info
+@@ -288,6 +291,7 @@ class MmuEnvironmentManager:
+ 
+             for gate in gates:
+                 self._heater_off(gate=gate)
++            self.stop_rotation()
+             return "Selected gate heaters turned off"
+ 
+         if self.is_drying():
+@@ -295,6 +299,7 @@ class MmuEnvironmentManager:
+             return "Cancelled drying cycle"
+ 
+         self._heater_off()
++        self.stop_rotation()
+         return "Heater turned off"
+ 
+ 
+@@ -656,31 +661,66 @@ class MmuEnvironmentManager:
+             self._rotate_timer -= ENV_CHECK_INTERVAL
+ 
+             if self._rotate_timer < 0:
+-                # Re-check EMPTY status at time of rotation (supports dynamic state changes)
+-                if self.has_per_gate_heaters():
+-                    candidates = list(self._get_active_gates())
+-                else:
+-                    candidates = self.mmu_unit.gate_range()
++                self._rotate_periodic()
++                self._rotate_timer = self._drying_rotate_interval * 60.0 # To seconds
+ 
+-                gates_to_rotate = []
+-                for gate in candidates:
+-                    try:
+-                        if self.mmu.gate_status[gate] == GATE_EMPTY:
+-                            gates_to_rotate.append(gate)
+-                    except Exception:
+-                        pass
++        # Reschedule
++        return eventtime + ENV_CHECK_INTERVAL
+ 
+-                if gates_to_rotate:
+-                    self._rotate_spools_in_gates(gates_to_rotate)
+ 
+-                gates_to_sweep = [gate for gate in candidates if self._can_sweep(gate)]
+-                if gates_to_sweep:
+-                    self._sweep_parked_spools(gates_to_sweep)
++    def _check_rotation(self, eventtime):
++        """
++        Rotation-only timer for raw heater control (MMU_HEATER TEMP=... ROTATE=1).
++        A drying cycle keeps using _check_mmu_environment for its rotation.
++        """
++        if not self._rotate_enabled or self._rotate_timer is None or self.is_drying():
++            return self.reactor.NEVER
++        self._rotate_timer -= ENV_CHECK_INTERVAL
++        if self._rotate_timer < 0:
++            self._rotate_periodic()
++            self._rotate_timer = self._drying_rotate_interval * 60.0
++        return eventtime + ENV_CHECK_INTERVAL
+ 
+-                self._rotate_timer = self._drying_rotate_interval * 60.0 # To seconds
++    def _rotate_periodic(self):
++        # Re-check EMPTY status at time of rotation (supports dynamic state changes)
++        if self.has_per_gate_heaters():
++            candidates = list(self._get_active_gates())
++        elif self._rotation_gates is not None:
++            candidates = list(self._rotation_gates)
++        else:
++            candidates = self.mmu_unit.gate_range()
+ 
+-        # Reschedule
+-        return eventtime + ENV_CHECK_INTERVAL
++        gates_to_rotate = []
++        for gate in candidates:
++            try:
++                if self.mmu.gate_status[gate] == GATE_EMPTY:
++                    gates_to_rotate.append(gate)
++            except Exception:
++                pass
++
++        if gates_to_rotate:
++            self._rotate_spools_in_gates(gates_to_rotate)
++
++        gates_to_sweep = [gate for gate in candidates if self._can_sweep(gate)]
++        if gates_to_sweep:
++            self._sweep_parked_spools(gates_to_sweep)
++
++    def start_rotation(self, gates=None, rotate_interval=None):
++        """Start spool rotation without starting a drying cycle (print heating)."""
++        self._rotate_enabled = True
++        self._drying_rotate_interval = rotate_interval or self.mmu_unit.p.heater_rotate_interval
++        self._rotate_timer = self._drying_rotate_interval * 60.0
++        self._rotation_gates = list(gates) if gates is not None else None
++        self._rotate_print_warned = False
++        if not self.is_drying():
++            self.reactor.update_timer(self._rotation_timer, self.reactor.NOW)
++
++    def stop_rotation(self):
++        self._rotate_timer = None
++        self._rotate_enabled = False
++        self._rotation_gates = None
++        if self._rotation_timer is not None:
++            self.reactor.update_timer(self._rotation_timer, self.reactor.NEVER)
+ 
+ 
+     def _start_drying_cycle(self, per_gate_plan=None):
+@@ -917,8 +957,7 @@ class MmuEnvironmentManager:
+                 self._drying_state = [DRYING_STATE_NONE] * self.mmu_unit.num_gates
+ 
+             # Stop rotation (a gear move in flight finishes, then its gear is turned off)
+-            self._rotate_timer = None
+-            self._rotate_enabled = False
++            self.stop_rotation()
+             self._bg_rotate_gates = []
+             if repark:
+                 self._repark_swept_spools()
+@@ -1345,7 +1384,7 @@ class MmuEnvironmentManager:
+ 
+ 
+     def _bg_can_rotate(self, gate, stepper, end_time, est_print_time=None):
+-        if not (self.is_drying() and self._rotate_enabled and self.mmu_unit.p.heater_rotate_in_print):
++        if not (self._rotate_enabled and self.mmu_unit.p.heater_rotate_in_print):
+             return False
+         if not self.mmu.is_in_print() or self.mmu.is_paused():
+             return False
+-- 
+2.47.3
+
diff --git a/patches/klipper/0011-mesh-toggle-virtual-output-pin.patch b/patches/klipper/0011-mesh-toggle-virtual-output-pin.patch
new file mode 100644
index 0000000..178dc21
--- /dev/null
+++ b/patches/klipper/0011-mesh-toggle-virtual-output-pin.patch
@@ -0,0 +1,43 @@
+diff --git a/klippy/extras/mesh_toggle_pin.py b/klippy/extras/mesh_toggle_pin.py
+new file mode 100644
+index 000000000..563c1512b
+--- /dev/null
++++ b/klippy/extras/mesh_toggle_pin.py
+@@ -0,0 +1,37 @@
++# Virtual output_pin backing the Mainsail "Miscellaneous" bed mesh toggle.
++#
++# Mainsail lists printer objects whose name starts with "output_pin " in its
++# Miscellaneous panel. This object has no physical pin; its value is backed by
++# the enable_auto_mesh save variable used by PRINT_START.
++
++class MeshTogglePin:
++    def __init__(self, config):
++        self.printer = config.get_printer()
++        self.name = config.get('pin_name', 'mesh_toggle')
++        self.gcode = self.printer.lookup_object('gcode')
++        self.gcode.register_mux_command(
++            'SET_PIN', 'PIN', self.name, self.cmd_SET_PIN,
++            desc='Set the virtual bed mesh toggle')
++        self.printer.add_object('output_pin ' + self.name, self)
++
++    def _save_vars(self):
++        return self.printer.lookup_object('save_variables')
++
++    def _value(self):
++        enabled = self._save_vars().allVariables.get('enable_auto_mesh', True)
++        return 1. if bool(enabled) else 0.
++
++    def get_status(self, eventtime):
++        return {'value': self._value()}
++
++    def cmd_SET_PIN(self, gcmd):
++        value = gcmd.get_float('VALUE', None, minval=0., maxval=1.)
++        if value is None:
++            raise gcmd.error('SET_PIN command must specify VALUE')
++        self.gcode.run_script_from_command(
++            'SAVE_VARIABLE VARIABLE=enable_auto_mesh VALUE=%s'
++            % ('True' if value > 0. else 'False'))
++
++
++def load_config(config):
++    return MeshTogglePin(config)
-- 
2.47.3

