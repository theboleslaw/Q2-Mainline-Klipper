diff --git a/patches/happy-hare/0009-feat-mmu-match-base-material-family.patch b/patches/happy-hare/0009-feat-mmu-match-base-material-family.patch
new file mode 100644
index 0000000..739f421
--- /dev/null
+++ b/patches/happy-hare/0009-feat-mmu-match-base-material-family.patch
@@ -0,0 +1,57 @@
+From 924f76b6e07ec4d18da503a3ce75c2e14af256a4 Mon Sep 17 00:00:00 2001
+From: q2-offload <q2-offload@users.noreply.github.com>
+Date: Tue, 10 Nov 2026 00:52:42 +0800
+Subject: [PATCH] feat(mmu): match base material family during automapping
+
+---
+ extras/mmu/mmu_gate_maps.py | 15 +++++++++++----
+ 1 file changed, 11 insertions(+), 4 deletions(-)
+
+diff --git a/extras/mmu/mmu_gate_maps.py b/extras/mmu/mmu_gate_maps.py
+index 39fe85ae..aab835a2 100644
+--- a/extras/mmu/mmu_gate_maps.py
++++ b/extras/mmu/mmu_gate_maps.py
+@@ -874,13 +874,17 @@ class MmuGateMaps:
+             elif strategy == AUTOMAP_CLOSEST_COLOR:
+                 if tool_to_remap['material'] == "unknown":
+                     errors.append("When automapping with closest color, the tool material must be set.")
+-                if tool_to_remap['material'] not in self.gate_material:
++                tool_family = self.material_family(tool_to_remap['material'])
++                if not any(
++                    self._normalize_material(material) and self.material_family(material) == tool_family
++                    for material in self.gate_material
++                ):
+                     errors.append("No gate has a filament matching the desired material (%s). Available are : %s" % (tool_to_remap['material'], self.gate_material))
+                 if not errors:
+                     color_list = []
+                     for gn, color in enumerate(search_in):
+                         gm = "".join(self.gate_material[gn].strip()).replace('#', '').lower()
+-                        if gm == tool_to_remap['material'].lower():
++                        if self.material_family(gm) == tool_family:
+                             color_list.append(color)
+                     if not color_list:
+                         errors.append("Gates with %s are missing color information..." % tool_to_remap['material'])
+@@ -889,7 +893,7 @@ class MmuGateMaps:
+                     closest, distance = MmuColorUtils.find_closest_color(tool_to_remap['color'], color_list)
+                     for gn, color in enumerate(search_in):
+                         gm = "".join(self.gate_material[gn].strip()).replace('#', '').lower()
+-                        if gm == tool_to_remap['material'].lower():
++                        if self.material_family(gm) == tool_family:
+                             if closest == color:
+                                 t = self.p.console_gate_stat
+                                 if distance > 0.5:
+@@ -953,7 +957,10 @@ class MmuGateMaps:
+     def _material_matches(self, tool_material, gate_material):
+         tm = self._normalize_material(tool_material)
+         gm = self._normalize_material(gate_material)
+-        return not tm or not gm or tm == gm
++        if not tm or not gm:
++            return True
++        # Match the base material family so "ASA" also matches "ASA-CF" and "ASA Silk".
++        return self.material_family(tm) == self.material_family(gm)
+ 
+     # Base material family is the leading name, e.g. "PLA Silk", "PLA-CF" and "PLA+" are all "pla"
+     def material_family(self, material):
+-- 
+2.47.3
+
